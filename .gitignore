# ---------- Secrets / API keys ----------
apiKey.txt
*.apikey
*.key
.env
.env.*
secrets.json

# ---------- OS junk ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---------- Editor / IDE ----------
.vscode/
.idea/
.vs/
*.swp
*.swo
*~

# ---------- Claude Code local state ----------
.claude/

# ============================================================
#  Python (Python_Backend/)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual envs
venv/
env/
.venv/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Project-specific Python artifacts
Python_Backend/npc_bellek/
Python_Backend/temp_gecici_bellek/
Python_Backend/current_voice.wav
Python_Backend/*.wav
Python_Backend/apiKey.txt

# ============================================================
